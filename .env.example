# 复制为 .env 并填写。后端启动时读取环境变量（用 `set -a; . .env; set +a` 或 direnv 加载）。

# DeepSeek API key，dsh 的 llm-deepseek 适配器用
DEEPSEEK_API_KEY=

# 引擎：dsh（真实）或 mock（离线演示，不调模型）
MUSE_ENGINE=dsh

# 模型路由（dsh-base 默认 deepseek-official / deepseek-flash）
MUSE_PROVIDER=deepseek-official
MUSE_MODEL=deepseek-flash

# 启动 dsh 的命令；本机装了全局 dsh 可以写 "dsh"
MUSE_DSH_BIN=npx --yes @deepseek-ai/dsh

# 同时跑几条任务
MUSE_MAX_CONCURRENT=3

# 监听地址（dsh 的 MCP 客户端会连 http://MUSE_HOST:MUSE_PORT/mcp）
MUSE_HOST=127.0.0.1
MUSE_PORT=8787
